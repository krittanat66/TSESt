# Copy this file to .env and fill it in. Never commit .env.

# The ID in your sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=

# --- Pick ONE of the two ways in ---

# (A) API key. Simplest, but only works while the sheet is shared as
#     "Anyone with the link can view" — meaning anyone holding the URL can
#     read your finances. Restrict the key to the Sheets API in Cloud Console.
GOOGLE_API_KEY=

# (B) Service account. Works on a private sheet. Share the sheet with the
#     client_email below as Viewer. Keep the key on one line in double
#     quotes with its \n escapes intact.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# Write path: the Apps Script Web App bound to the sheet (see apps-script/).
# The Sheets API key is read-only, so scores are written through the script.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

PORT=3001
CACHE_TTL_SECONDS=60
CORS_ORIGIN=http://localhost:5173
